# Meta MCP Server - Environment Configuration
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys below
# 3. NEVER commit .env to version control
#
# This file contains sensitive credentials for external API providers.

# ==========================================================================
# ANTHROPIC API (Required for Claude models)
# ==========================================================================
# Get your API key from: https://console.anthropic.com/settings/keys
# Used by LiteLLM to route requests to Claude models
ANTHROPIC_API_KEY=sk-ant-api03-...

# ==========================================================================
# OPENAI API (Required for GPT models)
# ==========================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used by LiteLLM to route requests to GPT models
OPENAI_API_KEY=sk-...

# ==========================================================================
# LITELLM (Optional)
# ==========================================================================
# Master key for LiteLLM proxy authentication
# If not set, LiteLLM will run without authentication
# Generate a secure key: openssl rand -hex 32
LITELLM_MASTER_KEY=

# ==========================================================================
# OPEN WEBUI (Optional)
# ==========================================================================
# Secret key for Open WebUI session encryption
# If not set, Open WebUI will generate one automatically
# Generate a secure key: openssl rand -hex 32
WEBUI_SECRET_KEY=


# ==========================================================================
# AI PROVIDER CONFIGURATION (Optional - defaults shown)
# ==========================================================================
# Embedding provider: "openai-compatible" for OpenAI-style APIs, or "gemini" for Google AI
# EMBEDDING_PROVIDER=openai-compatible

# Embedding API endpoint and credentials
# OpenAI: https://api.openai.com/v1
# Azure OpenAI example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# Ollama example (OpenAI-compatible): http://localhost:11434/v1
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...

# Embedding model name and vector dimensions
# OpenAI example: text-embedding-3-small (1536)
# Ollama example: nomic-embed-text
# Gemini example: text-embedding-004
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# LLM API endpoint and credentials (OpenAI-compatible; can point to LiteLLM or Ollama)
# LiteLLM proxy example: http://localhost:4000/v1
# Ollama example: http://localhost:11434/v1
# Azure OpenAI example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# LLM_BASE_URL=
# LLM_API_KEY=

# LLM model name
# OpenAI example: gpt-4o-mini
# LiteLLM proxy example: anthropic/claude-3-5-sonnet
# Ollama example: llama3.1
# Azure OpenAI example: gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# Qdrant vector store settings
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=chunks_v1

# Chunker tokenizer encoding used by tiktoken
# Set this to match your embedding/LLM tokenizer behavior when needed
# CHUNKER_ENCODING=cl100k_base

# ==========================================================================
# REDIS (Optional - uses default if not set)
# ==========================================================================
# Redis connection URL for meta-supervisor governance state
# Default: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# ==========================================================================
# META-SUPERVISOR (Optional - uses defaults if not set)
# ==========================================================================
# Host and port for meta-supervisor MCP server
# Default: 0.0.0.0:8001
# HOST=0.0.0.0
# PORT=8001

# Workspace root directory for file operations
# Default: ./workspace
# WORKSPACE_ROOT=./workspace

# Audit log path
# Default: ./audit.jsonl
# AUDIT_LOG_PATH=./audit.jsonl

# ==========================================================================
# NOTES
# ==========================================================================
# - API keys are loaded into Docker containers via docker-compose.yaml
# - Meta-supervisor runs on HOST (not in Docker) and reads from .env if using python-dotenv
# - For security, ensure .env is in .gitignore
# - Rotate API keys regularly
# - Use environment-specific .env files for dev/staging/prod
