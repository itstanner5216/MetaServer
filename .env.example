# Meta MCP Server - Environment Configuration
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys below
# 3. NEVER commit .env to version control
#
# This file contains sensitive credentials for external API providers.

# ==========================================================================
# ANTHROPIC API (Required for Claude models)
# ==========================================================================
# Get your API key from: https://console.anthropic.com/settings/keys
# Used by LiteLLM to route requests to Claude models
ANTHROPIC_API_KEY=sk-ant-api03-...

# ==========================================================================
# OPENAI API (Required for GPT models)
# ==========================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used by LiteLLM to route requests to GPT models
OPENAI_API_KEY=sk-...

# ==========================================================================
# AI PROVIDER CONFIGURATION (RAG + Chat)
# ==========================================================================
# Embedding provider type.
# - openai-compatible: Any OpenAI-compatible embeddings API (OpenAI, Ollama, LiteLLM, vLLM, etc.)
# - gemini: Google Generative AI embeddings
EMBEDDING_PROVIDER=openai-compatible

# Embedding API base URL.
# OpenAI: https://api.openai.com/v1
# Ollama (local): http://localhost:11434/v1
# LiteLLM proxy: http://localhost:4000/v1
# Azure OpenAI example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Embedding API key.
# OpenAI: sk-...
# Ollama local: can be blank
# LiteLLM proxy: set to your LiteLLM virtual key if enabled
# Azure OpenAI: your Azure key
EMBEDDING_API_KEY=

# Embedding model/deployment name.
# OpenAI: text-embedding-3-small (1536), text-embedding-3-large (3072)
# Ollama: nomic-embed-text
# LiteLLM: provider/model format (e.g. openai/text-embedding-3-small)
# Azure OpenAI: deployment name
EMBEDDING_MODEL=text-embedding-3-small

# Embedding vector dimension used by your vector store collection.
# Must match the selected embedding model output size.
EMBEDDING_DIMENSION=1536

# LLM inference base URL.
# OpenAI: https://api.openai.com/v1
# Ollama (local): http://localhost:11434/v1
# LiteLLM proxy: http://localhost:4000/v1
# Azure OpenAI example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
LLM_BASE_URL=

# LLM API key/token.
# OpenAI: sk-...
# Ollama local: can be blank
# LiteLLM proxy: set to your LiteLLM virtual key if enabled
# Azure OpenAI: your Azure key
LLM_API_KEY=

# LLM model/deployment name.
# OpenAI: gpt-4o-mini
# Ollama: llama3.1:8b
# LiteLLM: provider/model (e.g. openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022)
# Azure OpenAI: deployment name
LLM_MODEL=gpt-4o-mini

# Qdrant vector database URL and optional API key.
# Local default: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Default Qdrant collection for chunk embeddings.
QDRANT_COLLECTION=chunks_v1

# Tokenizer encoding used by chunking logic.
# Common value for OpenAI-compatible models: cl100k_base
CHUNKER_ENCODING=cl100k_base

# ==========================================================================
# LITELLM (Optional)
# ==========================================================================
# Master key for LiteLLM proxy authentication
# If not set, LiteLLM will run without authentication
# Generate a secure key: openssl rand -hex 32
LITELLM_MASTER_KEY=

# ==========================================================================
# OPEN WEBUI (Optional)
# ==========================================================================
# Secret key for Open WebUI session encryption
# If not set, Open WebUI will generate one automatically
# Generate a secure key: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ==========================================================================
# REDIS (Optional - uses default if not set)
# ==========================================================================
# Redis connection URL for meta-supervisor governance state
# Default: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# ==========================================================================
# META-SUPERVISOR (Optional - uses defaults if not set)
# ==========================================================================
# Host and port for meta-supervisor MCP server
# Default: 0.0.0.0:8001
# HOST=0.0.0.0
# PORT=8001

# Workspace root directory for file operations
# Default: ./workspace
# WORKSPACE_ROOT=./workspace

# Audit log path
# Default: ./audit.jsonl
# AUDIT_LOG_PATH=./audit.jsonl

# ==========================================================================
# NOTES
# ==========================================================================
# - API keys are loaded into Docker containers via docker-compose.yaml
# - Meta-supervisor runs on HOST (not in Docker) and reads from .env if using python-dotenv
# - For security, ensure .env is in .gitignore
# - Rotate API keys regularly
# - Use environment-specific .env files for dev/staging/prod
