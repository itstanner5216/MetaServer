# Meta MCP Server - Environment Configuration
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys below
# 3. NEVER commit .env to version control
#
# This file contains sensitive credentials for external API providers.

# ==========================================================================
# ANTHROPIC API (Required for Claude models)
# ==========================================================================
# Get your API key from: https://console.anthropic.com/settings/keys
# Used by LiteLLM to route requests to Claude models
ANTHROPIC_API_KEY=sk-ant-api03-...

# ==========================================================================
# OPENAI API (Required for GPT models)
# ==========================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used by LiteLLM to route requests to GPT models
OPENAI_API_KEY=sk-...

# ==========================================================================
# LITELLM (Optional)
# ==========================================================================
# Master key for LiteLLM proxy authentication
# If not set, LiteLLM will run without authentication
# Generate a secure key: openssl rand -hex 32
LITELLM_MASTER_KEY=

# ==========================================================================
# OPEN WEBUI (Optional)
# ==========================================================================
# Secret key for Open WebUI session encryption
# If not set, Open WebUI will generate one automatically
# Generate a secure key: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ==========================================================================
# AI PROVIDERS & VECTOR STORAGE (Optional)
# ==========================================================================
# Embedding provider type:
# - openai-compatible: any OpenAI-compatible /v1 embeddings endpoint
# - gemini: Google Gemini embeddings
# EMBEDDING_PROVIDER=openai-compatible

# Embedding endpoint and credentials
# OpenAI example:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Ollama local example (OpenAI-compatible):
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768

# Azure OpenAI example:
# EMBEDDING_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# EMBEDDING_API_KEY=<azure-api-key>
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# LiteLLM proxy example:
# EMBEDDING_BASE_URL=http://localhost:4000/v1
# EMBEDDING_API_KEY=<litellm-key>
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# LLM provider endpoint and credentials
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Ollama local example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# LiteLLM proxy example:
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_API_KEY=<litellm-key>
# LLM_MODEL=claude-3-5-sonnet

# Azure OpenAI example:
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# LLM_API_KEY=<azure-api-key>
# LLM_MODEL=gpt-4o-mini

# Qdrant vector database connection
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=chunks_v1

# Tokenizer encoding used by chunking logic
# CHUNKER_ENCODING=cl100k_base

# ==========================================================================
# REDIS (Optional - uses default if not set)
# ==========================================================================
# Redis connection URL for meta-supervisor governance state
# Default: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# ==========================================================================
# META-SUPERVISOR (Optional - uses defaults if not set)
# ==========================================================================
# Host and port for meta-supervisor MCP server
# Default: 0.0.0.0:8001
# HOST=0.0.0.0
# PORT=8001

# Workspace root directory for file operations
# Default: ./workspace
# WORKSPACE_ROOT=./workspace

# Audit log path
# Default: ./audit.jsonl
# AUDIT_LOG_PATH=./audit.jsonl

# ==========================================================================
# NOTES
# ==========================================================================
# - API keys are loaded into Docker containers via docker-compose.yaml
# - Meta-supervisor runs on HOST (not in Docker) and reads from .env if using python-dotenv
# - For security, ensure .env is in .gitignore
# - Rotate API keys regularly
# - Use environment-specific .env files for dev/staging/prod
